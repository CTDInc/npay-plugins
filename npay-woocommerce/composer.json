{
    "name": "npay/woocommerce",
    "description": "NPay payment gateway for WooCommerce — VietQR + automatic reconciliation via webhook.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://npay.vn",
    "authors": [
        {
            "name": "NPay",
            "email": "dev@npay.vn",
            "homepage": "https://npay.vn"
        }
    ],
    "keywords": [
        "wordpress",
        "woocommerce",
        "payment-gateway",
        "vietnam",
        "vietqr",
        "npay"
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "wp-coding-standards/wpcs": "^3.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "extra": {
        "installer-name": "npay-woocommerce",
        "wordpress-plugin": {
            "requires-at-least": "5.8",
            "requires-php": "7.4",
            "woocommerce-requires-at-least": "4.0"
        }
    },
    "minimum-stability": "stable"
}
