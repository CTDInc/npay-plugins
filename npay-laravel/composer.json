{
    "name": "npay/laravel",
    "description": "NPay Laravel package - tích hợp cổng thanh toán NPay (npay.vn) cho Laravel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["npay", "laravel", "payment", "vietqr", "vietnam", "banking"],
    "homepage": "https://npay.vn",
    "authors": [
        {
            "name": "NPay Team",
            "email": "dev@npay.vn",
            "homepage": "https://npay.vn"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/database": "^10.0|^11.0|^12.0",
        "illuminate/events": "^10.0|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "NPay\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NPay\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NPay\\Laravel\\NPayServiceProvider"
            ],
            "aliases": {
                "NPay": "NPay\\Laravel\\Facades\\NPay"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
